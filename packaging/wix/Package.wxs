<?xml version="1.0" encoding="utf-8"?>
<!--
  Lunar per-user MSI (ADR-0004, BE-29). Built with WiX 7.0.0 only by the owner (scripts\package-installer.ps1
  -WixTermsReviewedByOwner -AcceptWixEula). Smoke-test results are in docs\evidence\sprint-7\BE-29.md.

  Behavior:
    * Scope perUser: installs to %LocalAppData%\Programs\Lunar, HKCU only, no elevation prompt.
    * The whole self-contained publish folder is harvested (Files), so satellite folders such as
      id\Lunar.Desktop.resources.dll ship automatically. scripts\Test-InstallerPayload.ps1 checks that first.
    * Start with Windows is NOT registered here; it stays an in-app opt-in (IStartupRegistration). The MSI never
      owns the HKCU Run value (a RemoveRegistryValue row would run at INSTALL and erase the user's choice).
      On a full uninstall only (not an upgrade's removal of the old version) the deferred custom action
      LunarUninstallCleanup runs the installed exe in its uninstall-cleanup mode (ADR-0018, accepted): it removes
      the Run value and, unless the uninstall is silent, asks whether to delete %LocalAppData%\Lunar
      (default No). Its exit code is ignored, so it can never block the uninstall.
    * Per-user files under the user profile use file key paths, which ICE38/ICE64/ICE91 flag; those checks are
      suppressed in Lunar.Installer.wixproj (unverified until the first build).
    * Upgrades: MajorUpgrade (afterInstallInitialize) removes the older version inside the same transaction;
      Windows Installer rolls the whole transaction back, old version included, if any step fails. %LocalAppData%\Lunar (settings, logs) is never touched by the
      installer itself, so settings survive upgrade and rollback; only the user's Yes in the cleanup deletes them.
    * Updates (ADR-0025): Lunar's updater runs this MSI with LUNAR_RELAUNCH=1; only then LunarRelaunchAfterUpdate starts Lunar again at the
      end. An install by hand behaves as before.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Lunar"
           Manufacturer="Lunar"
           Version="$(var.ProductVersion)"
           UpgradeCode="6f0b4f0e-3c1d-4e5a-9a77-2d1c8b6e4a10"
           Scope="perUser"
           Language="1033">

    <!-- afterInstallInitialize: the old version is removed INSIDE this install's transaction, so a failed upgrade restores it.
         The default (afterInstallValidate) removed it before the transaction: a failed upgrade left no Lunar at all (BE-29 smoke test). -->
    <MajorUpgrade Schedule="afterInstallInitialize" DowngradeErrorMessage="A newer version of Lunar is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Lunar's icon for its Start menu shortcut (and so Windows Search) and for Settings > Apps > Installed apps. -->
    <Icon Id="LunarIcon.ico" SourceFile="..\..\src\Lunar.Desktop\Resources\Lunar.ico" />
    <Property Id="ARPPRODUCTICON" Value="LunarIcon.ico" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Lunar" />
      </Directory>
    </StandardDirectory>

    <!-- Every file of the publish folder, subfolders included. -->
    <ComponentGroup Id="Components" Directory="INSTALLFOLDER">
      <Files Include="$(var.PayloadDir)\**">
        <Exclude Files="$(var.PayloadDir)\**\*.pdb" />
      </Files>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="b3a2f6c4-8d1e-4f27-8c55-0a9e7d3b2f61">
        <Shortcut Id="LunarShortcut" Name="Lunar" Description="Lunar" Target="[INSTALLFOLDER]Lunar.Desktop.exe" WorkingDirectory="INSTALLFOLDER" Icon="LunarIcon.ico" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Lunar\Installer" Name="ShortcutInstalled" Type="integer" Value="1" KeyPath="yes" />
        <RemoveRegistryKey Root="HKCU" Key="Software\Lunar\Installer" Action="removeOnUninstall" />
      </Component>
    </StandardDirectory>

    <!-- ADR-0018. Type 34 (exe in a directory), deferred and impersonated: runs as the user before the files are removed. -->
    <CustomAction Id="LunarUninstallCleanup"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]Lunar.Desktop.exe&quot; --uninstall-cleanup --ui-level=[UILevel]"
                  Execute="deferred"
                  Impersonate="yes"
                  Return="ignore" />
    <!-- ADR-0025. Only when Lunar's own updater ran the MSI (it passes LUNAR_RELAUNCH=1): start the new Lunar once everything is installed.
         Immediate, after InstallFinalize, so it runs as the user and only after a successful install; asyncNoWait, so the MSI does not wait for it. -->
    <CustomAction Id="LunarRelaunchAfterUpdate"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]Lunar.Desktop.exe&quot;"
                  Execute="immediate"
                  Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="LunarUninstallCleanup" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="LunarRelaunchAfterUpdate" After="InstallFinalize" Condition="LUNAR_RELAUNCH=&quot;1&quot; AND NOT REMOVE" />
    </InstallExecuteSequence>

    <Feature Id="Main" Title="Lunar" Level="1">
      <ComponentGroupRef Id="Components" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
