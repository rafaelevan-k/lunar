<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Production entry point (FE-02). Single-instance and lifecycle policy follow in BE-05. -->
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The exe's own icon and name: the Start menu shortcut, Windows Search, the taskbar and Task Manager take them from the file. Without
         them Windows showed a blank icon and the file name "Lunar.Desktop". The file keeps its name, which the Start with Windows entry and
         the installer's uninstall step already point to. -->
    <ApplicationIcon>Resources\Lunar.ico</ApplicationIcon>
    <AssemblyTitle>Lunar</AssemblyTitle>
    <Product>Lunar</Product>
    <Company>Lunar</Company>
    <Copyright>Copyright 2026 Rafael Evan Kristanto</Copyright>
    <!-- WinForms is used only for NotifyIcon (the tray). WPF owns startup and DPI through app.manifest,
         so WinForms' ApplicationConfiguration bootstrap warning does not apply. -->
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <!-- Lunar is in English and Bahasa Indonesia (ADR-0017): only those satellite resources are published, including the
         WPF and Windows Forms runtime's own translations (the other 12 languages were never shown and only added size). -->
    <SatelliteResourceLanguages>en;id</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep WPF type names unambiguous: no implicit WinForms/Drawing imports. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <EmbeddedResource Include="Resources\Lunar.ico" LogicalName="Lunar.Desktop.Resources.Lunar.ico" />
    <InternalsVisibleTo Include="Lunar.Desktop.UITests" />
    <!-- Licence texts of every bundled third-party component, shipped next to the exe (BE-30); regenerate with scripts\Build-ThirdPartyNotices.ps1. -->
    <None Include="..\..\packaging\THIRD_PARTY_NOTICES.txt" Link="THIRD_PARTY_NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Lunar's own licence (Apache-2.0) and its NOTICE, which the licence asks redistributions to carry. -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\NOTICE" Link="NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The user guide and the privacy notice, installed next to the exe so the user has them without the source repository. -->
    <None Include="..\..\docs\USER_GUIDE.md" Link="USER_GUIDE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\docs\PRIVACY.md" Link="PRIVACY.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Sprint 0 discovery sources live in Spike/ and belong to Lunar.Desktop.Spike.csproj only. -->
    <Compile Remove="Spike\**" />
    <ApplicationDefinition Remove="Spike\**" />
    <Page Remove="Spike\**" />
    <None Remove="Spike\**" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="..\Lunar.Application\Lunar.Application.csproj" />
    <ProjectReference Include="..\Lunar.Domain\Lunar.Domain.csproj" />
    <!-- Adapter references are reserved for Composition/ServiceRegistration.cs. -->
    <ProjectReference Include="..\Lunar.Windows\Lunar.Windows.csproj" />
    <ProjectReference Include="..\Lunar.Conversion\Lunar.Conversion.csproj" />
    <ProjectReference Include="..\Lunar.Infrastructure\Lunar.Infrastructure.csproj" />
  </ItemGroup>
</Project>
