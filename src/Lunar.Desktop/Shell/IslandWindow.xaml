<Window x:Class="Lunar.Desktop.Shell.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Lunar.Desktop.Shell"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Lunar"
        Width="160" Height="44"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        automation:AutomationProperties.Name="Lunar"
        automation:AutomationProperties.ItemStatus="{Binding StatusText, Mode=OneWay}">
  <Window.InputBindings>
    <!-- Escape collapses the island whenever the window has keyboard focus (the guards are the state machine's). -->
    <KeyBinding Key="Escape" Command="{Binding CollapseCommand}" />
  </Window.InputBindings>
  <Window.Resources>
    <local:StadiumRadiusConverter x:Key="StadiumRadius" />
  </Window.Resources>
  <!-- The pill. At rest it fills the window, whose size IslandPositionController sets (FE-03, FE-05). While the island
       expands or collapses IslandWindow.AnimatePill gives it an explicit size that glides between idle and expanded (FE-10). -->
  <Border x:Name="Pill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
          Background="{DynamicResource Lunar.Brush.Background}"
          BorderBrush="{DynamicResource Lunar.Brush.Border}"
          BorderThickness="1"
          SnapsToDevicePixels="True">
    <!-- Radius is half the height up to the panel radius: a stadium while idle (like the iPhone Dynamic Island), 24 DIP
         in every expanded layout (PRD §3.5), and it follows the height smoothly while the pill grows or shrinks. -->
    <Border.CornerRadius>
      <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}" Converter="{StaticResource StadiumRadius}" />
    </Border.CornerRadius>
    <!-- Single view host: later features (eyes, pages) are presented here. -->
    <ContentControl x:Name="ViewHost" Focusable="False" IsTabStop="False" />
  </Border>
</Window>
