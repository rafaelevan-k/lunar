<UserControl x:Class="Lunar.Desktop.Features.SystemControls.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:c="clr-namespace:Lunar.Desktop.Controls"
             xmlns:local="clr-namespace:Lunar.Desktop.Features.SystemControls"
             Focusable="False" IsTabStop="False" Background="Transparent"
             automation:AutomationProperties.Name="System controls">
  <!--
    FE-13: the System page. It only binds to SystemPageViewModel (state and commands); there is no Windows API here and no
    logic in the code-behind. Every colour, size and font comes from the theme tokens, and every state a port can report
    (not read yet, unknown, not supported, denied, no device) has words instead of a broken control. The side margins keep
    the content clear of the swiper's arrow buttons.
  -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisible" />

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Lunar.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Lunar.Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- A Wi-Fi or Bluetooth card. -->
    <DataTemplate DataType="{x:Type local:RadioCardViewModel}">
      <Border Style="{StaticResource Card}" automation:AutomationProperties.Name="{Binding Title}">
        <StackPanel>
          <TextBlock Text="{Binding Title}" Style="{DynamicResource Lunar.Text.Caption}" />
          <Grid Margin="0,6,0,0" x:Name="Placeholder">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsLoaded}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <c:SkeletonBlock Height="18" />
          </Grid>
          <StackPanel Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVisible}}">
            <c:StatusChip Text="{Binding StatusText}" Kind="{Binding StatusKind}" HorizontalAlignment="Left" Margin="0,4,0,0" />
            <Button Content="{Binding ActionText}" Command="{Binding ToggleCommand}" Style="{DynamicResource Lunar.Style.ActionButton}"
                    HorizontalAlignment="Left" Margin="0,6,0,0"
                    Visibility="{Binding CanToggle, Converter={StaticResource BoolToVisible}}"
                    automation:AutomationProperties.Name="{Binding ActionText}" />
            <Button Content="Open Settings" Command="{Binding OpenSettingsCommand}" Style="{DynamicResource Lunar.Style.ActionButton}"
                    HorizontalAlignment="Left" Margin="0,6,0,0"
                    Visibility="{Binding ShowSettingsLink, Converter={StaticResource BoolToVisible}}"
                    automation:AutomationProperties.Name="Open Settings" />
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="40,4,40,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Date and time. -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,0,6" automation:AutomationProperties.Name="Date and time">
      <TextBlock x:Name="Time" Text="{Binding TimeText}" Style="{DynamicResource Lunar.Text.Title}" />
      <TextBlock x:Name="Date" Text="{Binding DateText}" Style="{DynamicResource Lunar.Text.Secondary}" VerticalAlignment="Bottom" Margin="10,0,0,3" />
    </StackPanel>

    <!-- Volume and mute. -->
    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,6" automation:AutomationProperties.Name="Volume">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" MinWidth="44" />
          </Grid.ColumnDefinitions>

          <c:IconButton x:Name="MuteButton" Grid.Column="0" Glyph="{Binding MuteGlyph}" Label="{Binding MuteLabel}"
                        Command="{Binding ToggleMuteCommand}" />

          <Grid x:Name="VolumePlaceholder" Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsVolumeLoaded}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <c:SkeletonBlock Height="16" />
          </Grid>

          <Slider x:Name="VolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                  Margin="8,0" VerticalAlignment="Center" Style="{DynamicResource Lunar.Style.Slider}"
                  Value="{Binding VolumePercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  Visibility="{Binding IsVolumeAvailable, Converter={StaticResource BoolToVisible}}"
                  automation:AutomationProperties.Name="Volume" />

          <TextBlock x:Name="VolumeNoteText" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding VolumeNote}" Margin="8,0,0,0"
                     VerticalAlignment="Center" TextWrapping="Wrap" Style="{DynamicResource Lunar.Text.Secondary}"
                     Visibility="{Binding VolumeNote, Converter={x:Static c:NullToVisibilityConverter.Instance}}" />

          <TextBlock x:Name="VolumeValue" Grid.Column="2" Text="{Binding VolumeText}" HorizontalAlignment="Right" VerticalAlignment="Center"
                     Style="{DynamicResource Lunar.Text.Body}"
                     Visibility="{Binding IsVolumeAvailable, Converter={StaticResource BoolToVisible}}" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- Wi-Fi and Bluetooth. -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <ContentControl x:Name="WifiCard" Grid.Column="0" Content="{Binding Wifi}" Focusable="False" IsTabStop="False" VerticalAlignment="Top" />
      <ContentControl x:Name="BluetoothCard" Grid.Column="2" Content="{Binding Bluetooth}" Focusable="False" IsTabStop="False" VerticalAlignment="Top" />
    </Grid>

    <!-- One shared error line for the page: errors take no room while there is none, and never push the cards. -->
    <c:InlineError x:Name="PageError" Grid.Row="3" Margin="0,6,0,0" MaxHeight="44" ClipToBounds="True" Message="{Binding ErrorMessage}" DismissCommand="{Binding DismissErrorCommand}" />
  </Grid>
</UserControl>
