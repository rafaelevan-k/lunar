<UserControl x:Class="Lunar.Desktop.Features.Converter.ConverterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Lunar.Desktop.Resources"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:c="clr-namespace:Lunar.Desktop.Controls"
             xmlns:nav="clr-namespace:Lunar.Desktop.Navigation"
             Focusable="False" IsTabStop="False" Background="Transparent" AllowDrop="True"
             automation:AutomationProperties.Name="{res:Text X.FileConverter}">
  <UserControl.Resources>
    <!-- Thicker outlines on this page, at the owner's request (2026-11-12): every button here that draws Lunar.Thickness.Outline follows it. -->
    <Thickness x:Key="Lunar.Thickness.Outline">2.4</Thickness>
    <BooleanToVisibilityConverter x:Key="BoolToVisible" />


    <!-- A format button: the selected one is filled with the page gradient, an unavailable one is dimmed and cannot be pressed.
         Self-contained on purpose (theme tokens only), so the page loads wherever its resources arrive from. -->
    <Style x:Key="FormatButton" TargetType="Button">
      <Setter Property="c:Squish.Enabled" Value="True" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="IsTabStop" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{DynamicResource Lunar.Style.FocusVisual}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="12,3" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Foreground" Value="{DynamicResource Lunar.Brush.Accent}" />
      <Setter Property="FontFamily" Value="{DynamicResource Lunar.Font.Family}" />
      <Setter Property="FontSize" Value="{DynamicResource Lunar.Font.Size.Body}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" CornerRadius="15" Padding="{TemplateBinding Padding}" Background="{DynamicResource Lunar.Brush.Surface}"
                    BorderBrush="{DynamicResource Lunar.Brush.Accent}" BorderThickness="{DynamicResource Lunar.Thickness.Outline}">
              <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Lunar.Brush.Accent}" />
                <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Lunar.Brush.OnAccent}" />
              </Trigger>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Lunar.Brush.Accent}" />
                <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Lunar.Brush.OnAccent}" />
              </DataTrigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Opacity" Value="0.4" />
                <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Lunar.Brush.TextDisabled}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <ItemsPanelTemplate x:Key="WrapPanelTemplate">
      <WrapPanel />
    </ItemsPanelTemplate>

    <!-- One button of a group of exclusive choices; it looks like a format button and the current one is filled. -->
    <DataTemplate x:Key="ChoiceButton">
      <Button Content="{Binding Label}" Command="{Binding SelectCommand}" Style="{StaticResource FormatButton}"
              automation:AutomationProperties.Name="{Binding AutomationName}" />
    </DataTemplate>

    <Style x:Key="OptionLabel" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource Lunar.Font.Family}" />
      <Setter Property="FontSize" Value="{DynamicResource Lunar.Font.Size.Caption}" />
      <Setter Property="Foreground" Value="{DynamicResource Lunar.Brush.TextSecondary}" />
      <Setter Property="Margin" Value="0,6,0,4" />
    </Style>

    <!-- A step of the path: a numbered gradient badge and a short title. -->
    <Style x:Key="StepBadge" TargetType="Border">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Background" Value="{DynamicResource Lunar.Brush.Accent}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="40,4,40,6">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ScrollViewer x:Name="PageScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="0,0,6,4">

        <StackPanel x:Name="FilesStep" Visibility="{Binding IsFilesStep, Converter={StaticResource BoolToVisible}}">
        <!-- Step 1: the files. -->
        <DockPanel Margin="0,0,0,6" LastChildFill="False">
          <Button x:Name="ShowConversionsButton" DockPanel.Dock="Right" Content="{res:Text X.Conversions}" Command="{Binding ShowConversionsCommand}" Margin="6,0,0,0" Visibility="{Binding Queue.HasRows, Converter={StaticResource BoolToVisible}}" Style="{DynamicResource Lunar.Style.ActionButton}" automation:AutomationProperties.Name="{res:Text X.ShowTheConversionsThatWere}" />
          <Button x:Name="ClearButton" DockPanel.Dock="Right" Content="{res:Text X.Clear}" Command="{Binding ClearCommand}" Visibility="{Binding HasItems, Converter={StaticResource BoolToVisible}}"
                  Style="{DynamicResource Lunar.Style.ActionButton}" automation:AutomationProperties.Name="{res:Text X.RemoveAllFilesFromThe}" />
          <Button x:Name="AddButton" DockPanel.Dock="Right" Content="{res:Text X.AddFiles}" Command="{Binding AddFilesCommand}" Margin="0,0,6,0"
                  Style="{DynamicResource Lunar.Style.ActionButton}" automation:AutomationProperties.Name="{res:Text X.AddFilesToConvert}" />
          <Border DockPanel.Dock="Left" Style="{StaticResource StepBadge}">
            <TextBlock Text="1" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Lunar.Brush.OnAccent}" />
          </Border>
          <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
            <TextBlock Text="{res:Text X.AddFiles}" Style="{DynamicResource Lunar.Text.Subtitle}" />
            <TextBlock x:Name="SummaryText" Text="{Binding SummaryText}" Style="{DynamicResource Lunar.Text.Caption}" TextTrimming="CharacterEllipsis"
                       automation:AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </DockPanel>

        <!-- The drop hint while the list is empty, the list otherwise. The border lights up while files are dragged over. -->
        <Border x:Name="DropArea" MinHeight="84" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource Lunar.Brush.Border}"
                Background="{DynamicResource Lunar.Brush.Surface}">
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsDragActive}" Value="True">
                  <Setter Property="BorderBrush" Value="{DynamicResource Lunar.Brush.Accent}" />
                  <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid>
            <StackPanel x:Name="EmptyFace" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisible}}"
                        automation:AutomationProperties.Name="{res:Text X.NoFilesYetDropFiles}">
              <TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28" HorizontalAlignment="Center"
                         Foreground="{DynamicResource Lunar.Brush.Accent}" />
              <TextBlock Text="{res:Text X.DropFilesHere}" Style="{DynamicResource Lunar.Text.Subtitle}" HorizontalAlignment="Center" Margin="0,6,0,0" />
              <TextBlock Text="{res:Text X.PNGJPGJPEGDOCXAnd}" Style="{DynamicResource Lunar.Text.Secondary}"
                         TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
            </StackPanel>

            <ScrollViewer x:Name="ListScroll" MaxHeight="130" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                          Visibility="{Binding HasItems, Converter={StaticResource BoolToVisible}}" nav:SwiperView.BlocksSwipe="True">
              <ItemsControl x:Name="FileList" ItemsSource="{Binding Items}" Focusable="False" Margin="6">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,2" automation:AutomationProperties.Name="{Binding AutomationName}" ToolTip="{Binding FullPath}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{DynamicResource Lunar.Text.Body}" />
                        <TextBlock Style="{DynamicResource Lunar.Text.Caption}" TextWrapping="Wrap" Visibility="{Binding IsNotRefused, Converter={StaticResource BoolToVisible}}">
                          <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} - {1}">
                              <Binding Path="KindText" />
                              <Binding Path="Message" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                        <!-- A refused file's line is in the error colour; it also says why in words, so colour is never the only cue. -->
                        <TextBlock Style="{DynamicResource Lunar.Text.Error}" TextWrapping="Wrap" Visibility="{Binding IsRefused, Converter={StaticResource BoolToVisible}}">
                          <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} - {1}">
                              <Binding Path="KindText" />
                              <Binding Path="Message" />
                            </MultiBinding>
                          </TextBlock.Text>
                        </TextBlock>
                      </StackPanel>
                      <c:IconButton Grid.Column="1" Glyph="&#xE711;" Label="Remove from the list" Command="{Binding RemoveCommand}" Width="28" Height="28" VerticalAlignment="Top" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        </StackPanel>

        <StackPanel x:Name="ProgressStep" Visibility="{Binding IsProgressStep, Converter={StaticResource BoolToVisible}}">
        <!-- The conversions that were started: state, honest progress, cancel, retry, show in folder. They keep running when the island closes. -->
        <StackPanel x:Name="QueuePanel" DataContext="{Binding Queue}" Margin="0,10,0,0" Visibility="{Binding HasRows, Converter={StaticResource BoolToVisible}}">
          <DockPanel LastChildFill="False" Margin="0,0,0,4">
            <Button x:Name="ClearFinishedButton" DockPanel.Dock="Right" Content="{res:Text X.ClearFinished}" Command="{Binding ClearFinishedCommand}"
                    Style="{DynamicResource Lunar.Style.ActionButton}" automation:AutomationProperties.Name="{res:Text X.RemoveFinishedConversionsFromThe}" />
            <Button x:Name="CancelAllButton" DockPanel.Dock="Right" Content="{res:Text X.CancelAll}" Command="{Binding CancelAllCommand}" Margin="0,0,6,0"
                    Style="{DynamicResource Lunar.Style.ActionButton}" automation:AutomationProperties.Name="{res:Text X.CancelEveryWaitingAndRunning}" />
            <TextBlock x:Name="QueueSummary" DockPanel.Dock="Left" Text="{Binding SummaryText}" Style="{DynamicResource Lunar.Text.Subtitle}" VerticalAlignment="Center"
                       automation:AutomationProperties.LiveSetting="Polite" />
          </DockPanel>
          <c:InlineError x:Name="QueueError" Message="{Binding ErrorMessage}" DismissCommand="{Binding DismissErrorCommand}" Margin="0,0,0,6" />
          <ItemsControl x:Name="JobList" ItemsSource="{Binding Rows}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,6" Padding="10" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Lunar.Brush.Border}"
                        Background="{DynamicResource Lunar.Brush.Surface}" automation:AutomationProperties.Name="{Binding AutomationName}" ToolTip="{Binding FirstOutputPath}">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Style="{DynamicResource Lunar.Text.Body}" />
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Style="{DynamicResource Lunar.Text.Caption}" Visibility="{Binding IsNotFailed, Converter={StaticResource BoolToVisible}}" />
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Style="{DynamicResource Lunar.Text.Error}" Visibility="{Binding IsFailed, Converter={StaticResource BoolToVisible}}" />
                    <!-- Progress is shown only as the converter reports it: a value and "n of m pages" when the page count is known, an indeterminate bar otherwise. -->
                    <ProgressBar Minimum="0" Maximum="1" Value="{Binding Fraction, Mode=OneWay, TargetNullValue=0}" IsIndeterminate="{Binding IsIndeterminate}" Height="6" Margin="0,6,0,0"
                                 BorderThickness="0" Foreground="{DynamicResource Lunar.Brush.Accent}" Background="{DynamicResource Lunar.Brush.TextDisabled}"
                                 Visibility="{Binding ShowProgressBar, Converter={StaticResource BoolToVisible}}" automation:AutomationProperties.Name="{res:Text X.Progress}" />
                    <TextBlock Text="{Binding ProgressText}" Style="{DynamicResource Lunar.Text.Caption}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding ResultText}" Style="{DynamicResource Lunar.Text.Caption}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                      <Button Content="{res:Text X.Cancel}" Command="{Binding CancelCommand}" Margin="0,0,6,0" Style="{DynamicResource Lunar.Style.ActionButton}"
                              Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisible}}" automation:AutomationProperties.Name="{res:Text X.CancelThisConversion}" />
                      <Button Content="{res:Text X.TryAgain}" Command="{Binding RetryCommand}" Margin="0,0,6,0" Style="{DynamicResource Lunar.Style.ActionButton}"
                              Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisible}}" automation:AutomationProperties.Name="{res:Text X.TryThisConversionAgain}" />
                      <Button Content="{res:Text X.ShowInFolder}" Command="{Binding RevealCommand}" Style="{DynamicResource Lunar.Style.ActionButton}"
                              Visibility="{Binding CanReveal, Converter={StaticResource BoolToVisible}}" automation:AutomationProperties.Name="{res:Text X.ShowTheResultInIts}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        </StackPanel>

        <!-- Notice and error. -->
        <Border Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisible}}" Margin="0,8,0,0">
          <DockPanel automation:AutomationProperties.LiveSetting="Polite">
            <Button DockPanel.Dock="Right" Content="{res:Text X.OK}" Command="{Binding DismissNoticeCommand}" Style="{DynamicResource Lunar.Style.ActionButton}"
                    automation:AutomationProperties.Name="{res:Text X.DismissTheNotice}" />
            <TextBlock x:Name="NoticeText" Text="{Binding Notice}" Style="{DynamicResource Lunar.Text.Caption}" TextWrapping="Wrap" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
        <c:InlineError x:Name="ErrorBar" Message="{Binding ErrorMessage}" DismissCommand="{Binding DismissErrorCommand}" Margin="0,8,0,0" />

        <StackPanel x:Name="FormatStep" Visibility="{Binding IsFormatStep, Converter={StaticResource BoolToVisible}}">
        <!-- Step 2: the output format, with what the chosen route does to the files said plainly right under the buttons. -->
        <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
          <Border Style="{StaticResource StepBadge}">
            <TextBlock Text="2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Lunar.Brush.OnAccent}" />
          </Border>
          <TextBlock Text="{res:Text X.PickAFormat}" Style="{DynamicResource Lunar.Text.Subtitle}" VerticalAlignment="Center" />
        </StackPanel>
        <ItemsControl x:Name="FormatList" ItemsSource="{Binding Targets}" Focusable="False" ItemsPanel="{StaticResource WrapPanelTemplate}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Content="{Binding Label}" Command="{Binding SelectCommand}" Style="{StaticResource FormatButton}" ToolTip="{Binding Note}"
                      automation:AutomationProperties.Name="{Binding AutomationName}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ItemsControl x:Name="NoticeList" ItemsSource="{Binding Options.Notices}" Focusable="False" Margin="0,2,0,0" Visibility="{Binding Options.HasNotices, Converter={StaticResource BoolToVisible}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Style="{DynamicResource Lunar.Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,4" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        </StackPanel>

        <StackPanel x:Name="TweaksStep" Visibility="{Binding IsTweaksStep, Converter={StaticResource BoolToVisible}}">
        <!-- Step 3: the tweaks that fit the route (and where the results go). -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
          <Border Style="{StaticResource StepBadge}">
            <TextBlock Text="3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Lunar.Brush.OnAccent}" />
          </Border>
          <TextBlock Text="{res:Text X.Tweaks}" Style="{DynamicResource Lunar.Text.Subtitle}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="TweaksSummaryText" Text="{Binding TweaksSummary}" Style="{DynamicResource Lunar.Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,4" />
        <StackPanel x:Name="TweaksFold" DataContext="{Binding Options}" Margin="0,4,0,0">
          <StackPanel x:Name="OptionsPanel">
            <StackPanel x:Name="QualityBlock" Visibility="{Binding ShowQuality, Converter={StaticResource BoolToVisible}}">
              <TextBlock x:Name="QualityLabel" Text="{Binding QualityText}" Style="{StaticResource OptionLabel}" />
              <Slider Minimum="1" Maximum="100" Value="{Binding JpegQuality, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10"
                      Style="{DynamicResource Lunar.Style.Slider}" automation:AutomationProperties.Name="{res:Text X.JPEGQuality}"
                      automation:AutomationProperties.HelpText="{res:Text X.1IsTheSmallestFile}" />
            </StackPanel>

            <StackPanel x:Name="BackgroundBlock" Visibility="{Binding ShowBackground, Converter={StaticResource BoolToVisible}}">
              <TextBlock Text="{res:Text X.BackgroundForTransparentAreas}" Style="{StaticResource OptionLabel}" />
              <ItemsControl ItemsSource="{Binding Background.Options}" ItemTemplate="{StaticResource ChoiceButton}" ItemsPanel="{StaticResource WrapPanelTemplate}" Focusable="False" />
            </StackPanel>

            <StackPanel x:Name="PdfBlock" Visibility="{Binding ShowPdf, Converter={StaticResource BoolToVisible}}">
              <TextBlock Text="{res:Text X.ResolutionPixelsPerInch}" Style="{StaticResource OptionLabel}" />
              <ItemsControl ItemsSource="{Binding Dpi.Options}" ItemTemplate="{StaticResource ChoiceButton}" ItemsPanel="{StaticResource WrapPanelTemplate}" Focusable="False" />
              <TextBlock Text="{res:Text X.PagesEmptyMeansEveryPage}" Style="{StaticResource OptionLabel}" />
              <TextBox x:Name="PagesBox" Text="{Binding PagesText, UpdateSourceTrigger=PropertyChanged}" MaxLength="500"
                       Background="{DynamicResource Lunar.Brush.Surface}" Foreground="{DynamicResource Lunar.Brush.TextPrimary}"
                       BorderBrush="{DynamicResource Lunar.Brush.Border}" CaretBrush="{DynamicResource Lunar.Brush.TextPrimary}" Padding="6,4"
                       automation:AutomationProperties.Name="{res:Text X.PagesToConvert}" />
              <TextBlock x:Name="PagesProblemText" Text="{Binding PagesProblem}" Style="{DynamicResource Lunar.Text.Error}" TextWrapping="Wrap" Margin="0,4,0,0"
                         Visibility="{Binding HasPagesProblem, Converter={StaticResource BoolToVisible}}" automation:AutomationProperties.LiveSetting="Assertive" />
              <TextBlock Text="{res:Text X.PasswordIfAPDFIs}" Style="{StaticResource OptionLabel}" />
              <PasswordBox x:Name="PdfPasswordBox" Background="{DynamicResource Lunar.Brush.Surface}" Foreground="{DynamicResource Lunar.Brush.TextPrimary}"
                           BorderBrush="{DynamicResource Lunar.Brush.Border}" CaretBrush="{DynamicResource Lunar.Brush.TextPrimary}" Padding="6,4" MaxLength="256"
                           automation:AutomationProperties.Name="{res:Text X.PDFPassword}" />
            </StackPanel>

            <StackPanel x:Name="LayoutBlock" Visibility="{Binding ShowLayout, Converter={StaticResource BoolToVisible}}">
              <TextBlock Text="{res:Text X.PageSize}" Style="{StaticResource OptionLabel}" />
              <ItemsControl ItemsSource="{Binding PageSizes.Options}" ItemTemplate="{StaticResource ChoiceButton}" ItemsPanel="{StaticResource WrapPanelTemplate}" Focusable="False" />
              <TextBlock Text="{res:Text X.Margin}" Style="{StaticResource OptionLabel}" />
              <ItemsControl ItemsSource="{Binding Margins.Options}" ItemTemplate="{StaticResource ChoiceButton}" ItemsPanel="{StaticResource WrapPanelTemplate}" Focusable="False" />
              <TextBlock Text="{res:Text X.PictureOnThePage}" Style="{StaticResource OptionLabel}" />
              <ItemsControl ItemsSource="{Binding Fits.Options}" ItemTemplate="{StaticResource ChoiceButton}" ItemsPanel="{StaticResource WrapPanelTemplate}" Focusable="False" />
            </StackPanel>

            <!-- If a result's name is taken. -->
            <TextBlock Text="{res:Text X.IfAResultSName}" Style="{StaticResource OptionLabel}" />
            <ItemsControl ItemsSource="{Binding Collisions.Options}" ItemTemplate="{StaticResource ChoiceButton}" ItemsPanel="{StaticResource WrapPanelTemplate}" Focusable="False" />
            <TextBlock x:Name="OverwriteWarning" Text="{res:Text X.ExistingResultsWithTheSame}"
                       Style="{DynamicResource Lunar.Text.Error}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding ShowOverwriteWarning, Converter={StaticResource BoolToVisible}}" />
          </StackPanel>
        </StackPanel>

        <!-- Where the results go (also part of the tweaks; always visible so there is never a doubt). -->
        <TextBlock Text="{res:Text X.SaveResultsIn}" Style="{StaticResource OptionLabel}" Margin="0,10,0,4" />
        <DockPanel>
          <Button x:Name="FolderButton" DockPanel.Dock="Right" Content="{res:Text X.Change}" Command="{Binding ChooseFolderCommand}" Margin="8,0,0,0"
                  Style="{DynamicResource Lunar.Style.ActionButton}" automation:AutomationProperties.Name="{res:Text X.ChooseTheFolderForThe}" />
          <TextBlock x:Name="FolderText" Text="{Binding OutputFolder}" ToolTip="{Binding OutputFolder}" Style="{DynamicResource Lunar.Text.Body}" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </DockPanel>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <!-- The bottom bar stays while the steps scroll: the replace question when it is needed, the big Convert button, and why it cannot start when it cannot. -->
    <StackPanel Grid.Row="1" Margin="0,6,0,0">
      <Border x:Name="OverwriteConfirm" Margin="0,0,0,6" Padding="8" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Lunar.Brush.Error}"
              Background="{DynamicResource Lunar.Brush.Surface}" Visibility="{Binding IsConfirmingOverwrite, Converter={StaticResource BoolToVisible}}"
              automation:AutomationProperties.LiveSetting="Assertive">
        <StackPanel>
          <TextBlock Text="{res:Text X.ReplaceExistingResultsWithThe}" Style="{DynamicResource Lunar.Text.Body}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button x:Name="ConfirmReplaceButton" Content="{res:Text X.ReplaceAndConvert}" Command="{Binding ConfirmOverwriteCommand}" Margin="0,0,6,0"
                    Style="{DynamicResource Lunar.Style.ActionButton}" automation:AutomationProperties.Name="{res:Text X.ReplaceExistingResultsAndConvert}" />
            <Button x:Name="CancelReplaceButton" Content="{res:Text X.Cancel}" Command="{Binding CancelOverwriteCommand}" Style="{DynamicResource Lunar.Style.ActionButton}"
                    automation:AutomationProperties.Name="{res:Text X.DoNotReplaceGoBack}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- One primary action per step: Next, Next, Convert, and Convert more once the conversions are shown. Back is always a quiet button beside it. -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Button x:Name="BackButton" Grid.Column="0" Content="{res:Text X.Back}" Command="{Binding BackCommand}" Margin="0,0,8,0" Style="{DynamicResource Lunar.Style.ActionButton}"
                Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisible}}" automation:AutomationProperties.Name="{res:Text X.GoBackOneStep}" />
        <Button x:Name="NextButton" Grid.Column="1" Content="{res:Text X.Next}" Command="{Binding NextCommand}" Style="{DynamicResource Lunar.Style.PrimaryButton}"
                Visibility="{Binding ShowNext, Converter={StaticResource BoolToVisible}}" automation:AutomationProperties.Name="{res:Text X.GoToTheNextStep}" />
        <Button x:Name="ConvertButton" Grid.Column="1" Content="{res:Text X.Convert}" Command="{Binding StartCommand}" HorizontalAlignment="Stretch"
                Style="{DynamicResource Lunar.Style.PrimaryButton}" automation:AutomationProperties.Name="{res:Text X.ConvertTheListedFiles}"
                automation:AutomationProperties.HelpText="{Binding StartHint}" Visibility="{Binding IsTweaksStep, Converter={StaticResource BoolToVisible}}" />
        <Button x:Name="ConvertMoreButton" Grid.Column="1" Content="{res:Text X.ConvertMoreFiles}" Command="{Binding ConvertMoreCommand}" Style="{DynamicResource Lunar.Style.PrimaryButton}"
                Visibility="{Binding IsProgressStep, Converter={StaticResource BoolToVisible}}" automation:AutomationProperties.Name="{res:Text X.StartOverWithNewFiles}" />
      </Grid>      <TextBlock x:Name="StartHintText" Text="{Binding StepHint}" Style="{DynamicResource Lunar.Text.Caption}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"
                 automation:AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
  </Grid>
</UserControl>
