<Window x:Class="Lunar.Desktop.Features.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Lunar.Desktop.Resources"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:c="clr-namespace:Lunar.Desktop.Controls"
        Title="{res:Text X.LunarSettings}" Width="480" Height="680" MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource Lunar.Brush.Background}"
        FontFamily="{DynamicResource Lunar.Font.Family}" FontSize="{DynamicResource Lunar.Font.Size.Body}"
        Foreground="{DynamicResource Lunar.Brush.TextPrimary}"
        automation:AutomationProperties.Name="{res:Text X.LunarSettings}">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisible" />

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Lunar.Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Lunar.Brush.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Lunar.Brush.TextPrimary}" />
      <Setter Property="FontSize" Value="{DynamicResource Lunar.Font.Size.Subtitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="automation:AutomationProperties.HeadingLevel" Value="Level2" />
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Lunar.Brush.TextSecondary}" />
      <Setter Property="FontSize" Value="{DynamicResource Lunar.Font.Size.Caption}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>

    <!-- One choice of a group: a pill that is filled for the saved choice. It is a radio button, so assistive technology says "selected". -->
    <Style x:Key="ChoiceRadio" TargetType="RadioButton">
      <Setter Property="Focusable" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Foreground" Value="{DynamicResource Lunar.Brush.TextPrimary}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid Background="Transparent">
              <Rectangle x:Name="FocusRing" Margin="-3" RadiusX="18" RadiusY="18" StrokeThickness="2"
                         Stroke="{DynamicResource Lunar.Brush.Focus}" Visibility="Collapsed" />
              <Border x:Name="Face" CornerRadius="16" Padding="14,5" Background="{DynamicResource Lunar.Brush.Surface}"
                      BorderBrush="{DynamicResource Lunar.Brush.TextDisabled}" BorderThickness="{DynamicResource Lunar.Thickness.Outline}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Lunar.Brush.Accent}" />
                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Lunar.Brush.Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Lunar.Brush.OnAccent}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Lunar.Brush.Accent}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="20,18,20,12">
      <TextBlock Text="{res:Text X.Settings}" Style="{DynamicResource Lunar.Text.Title}" FontWeight="SemiBold" Margin="0,0,0,12"
                 automation:AutomationProperties.HeadingLevel="Level1" />

      <!-- A repair made when Lunar started, or a newer file that cannot be changed. -->
      <Border x:Name="NoticeCard" Style="{StaticResource Card}" Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisible}}"
              automation:AutomationProperties.LiveSetting="Polite">
        <StackPanel>
          <TextBlock x:Name="NoticeText" Text="{Binding Notice}" Style="{DynamicResource Lunar.Text.Body}" TextWrapping="Wrap" />
          <Button x:Name="DismissNoticeButton" Content="{res:Text X.Dismiss}" Command="{Binding DismissNoticeCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                  Style="{DynamicResource Lunar.Style.ActionButton}" automation:AutomationProperties.Name="{res:Text X.DismissThisNotice}" />
        </StackPanel>
      </Border>

      <!-- Why the last change did not happen. -->
      <Border x:Name="ProblemCard" Style="{StaticResource Card}" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisible}}"
              automation:AutomationProperties.LiveSetting="Assertive">
        <TextBlock x:Name="ProblemText" Text="{Binding Problem}" Style="{DynamicResource Lunar.Text.Error}" TextWrapping="Wrap" />
      </Border>

      <!-- Start with Windows (BE-29 registration, wired in FE-26): what Windows has, read again whenever the window is brought forward. -->
      <Border Style="{StaticResource Card}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="{res:Text X.StartWithWindows}" Style="{StaticResource SectionTitle}" Margin="0" />
            <TextBlock x:Name="StartupHint" Text="{Binding StartupHint}" Style="{StaticResource Hint}" />
          </StackPanel>
          <Button x:Name="StartupSwitch" Grid.Column="1" Style="{DynamicResource Lunar.Style.SwitchButton}" VerticalAlignment="Center"
                  c:SwitchState.IsOn="{Binding StartupEnabled}" Command="{Binding ToggleStartupCommand}"
                  automation:AutomationProperties.Name="{res:Text X.StartWithWindows}"
                  automation:AutomationProperties.HelpText="{Binding StartupHint}" />
        </Grid>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{res:Text X.Display}" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{res:Text X.ShowLunarOn}" Style="{DynamicResource Lunar.Text.Secondary}" Margin="0,0,0,6" />
          <ItemsControl x:Name="MonitorList" ItemsSource="{Binding Monitors}" Focusable="False" IsTabStop="False"
                        automation:AutomationProperties.Name="{res:Text X.ShowLunarOn}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton Style="{StaticResource ChoiceRadio}" GroupName="Lunar.Settings.Monitor" Content="{Binding Label}"
                             IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding Command}"
                             automation:AutomationProperties.Name="{Binding Label}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="{res:Text X.DistanceFromTheTopOf}" Style="{DynamicResource Lunar.Text.Secondary}" Margin="0,6,0,6" />
          <StackPanel Orientation="Horizontal">
            <Button x:Name="OffsetDownButton" Content="&#x2212;" Command="{Binding OffsetDownCommand}" MinWidth="36"
                    Style="{DynamicResource Lunar.Style.ActionButton}" automation:AutomationProperties.Name="{res:Text X.MoveTheIslandCloserTo}" />
            <TextBlock x:Name="OffsetValue" Text="{Binding TopOffsetText}" Style="{DynamicResource Lunar.Text.Body}" MinWidth="64" TextAlignment="Center"
                       VerticalAlignment="Center" Margin="8,0" automation:AutomationProperties.Name="{res:Text X.DistanceFromTheTop}" />
            <Button x:Name="OffsetUpButton" Content="+" Command="{Binding OffsetUpCommand}" MinWidth="36"
                    Style="{DynamicResource Lunar.Style.ActionButton}" automation:AutomationProperties.Name="{res:Text X.MoveTheIslandFurtherFrom}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{res:Text X.Appearance}" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{res:Text X.Theme}" Style="{DynamicResource Lunar.Text.Secondary}" Margin="0,0,0,6" />
          <ItemsControl x:Name="ThemeList" ItemsSource="{Binding Themes}" Focusable="False" IsTabStop="False" automation:AutomationProperties.Name="{res:Text X.Theme}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton Style="{StaticResource ChoiceRadio}" GroupName="Lunar.Settings.Theme" Content="{Binding Label}"
                             IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding Command}"
                             automation:AutomationProperties.Name="{Binding Label}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="{res:Text Settings.LanguageHeading}" Style="{DynamicResource Lunar.Text.Secondary}" Margin="0,12,0,6" />
          <ItemsControl x:Name="LanguageList" ItemsSource="{Binding Languages}" Focusable="False" IsTabStop="False" automation:AutomationProperties.Name="{res:Text Settings.LanguageHeading}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <RadioButton Style="{StaticResource ChoiceRadio}" GroupName="Lunar.Settings.Language" Content="{Binding Label}"
                             IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding Command}"
                             automation:AutomationProperties.Name="{Binding Label}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="LanguageRestart" Text="{res:Text Settings.LanguageRestart}" Style="{StaticResource Hint}"
                     Visibility="{Binding LanguageNeedsRestart, Converter={StaticResource BoolToVisible}}" />

          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{res:Text X.ReduceMotion}" Style="{DynamicResource Lunar.Text.Body}" />
              <TextBlock Text="{res:Text X.NoSlidesFadesOrConfetti}" Style="{StaticResource Hint}" />
            </StackPanel>
            <Button x:Name="ReduceMotionSwitch" Grid.Column="1" Style="{DynamicResource Lunar.Style.SwitchButton}" VerticalAlignment="Center"
                    c:SwitchState.IsOn="{Binding ReduceMotion}" Command="{Binding ToggleReduceMotionCommand}"
                    automation:AutomationProperties.Name="{res:Text X.ReduceMotion}" />
          </Grid>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{res:Text X.AnimatedEyes}" Style="{DynamicResource Lunar.Text.Body}" />
              <TextBlock Text="{res:Text X.TheEyesBlinkAndLook}" Style="{StaticResource Hint}" />
            </StackPanel>
            <Button x:Name="EyesSwitch" Grid.Column="1" Style="{DynamicResource Lunar.Style.SwitchButton}" VerticalAlignment="Center"
                    c:SwitchState.IsOn="{Binding EyeAnimationEnabled}" Command="{Binding ToggleEyesCommand}"
                    automation:AutomationProperties.Name="{res:Text X.AnimatedEyes}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{res:Text X.FileConverter}" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{res:Text X.WhereConvertedFilesGo}" Style="{DynamicResource Lunar.Text.Secondary}" />
          <TextBlock x:Name="FolderText" Text="{Binding OutputFolderText}" Style="{DynamicResource Lunar.Text.Body}" TextWrapping="Wrap" Margin="0,2,0,8"
                     automation:AutomationProperties.Name="{res:Text X.FolderForConvertedFiles}" />
          <StackPanel Orientation="Horizontal">
            <Button x:Name="ChooseFolderButton" Content="{res:Text X.ChooseFolder}" Command="{Binding ChooseFolderCommand}" Margin="0,0,8,0"
                    Style="{DynamicResource Lunar.Style.ActionButton}" automation:AutomationProperties.Name="{res:Text X.ChooseAFolderForConverted}" />
            <Button x:Name="ClearFolderButton" Content="{res:Text X.UseTheDefault}" Command="{Binding ClearFolderCommand}"
                    Style="{DynamicResource Lunar.Style.ActionButton}" automation:AutomationProperties.Name="{res:Text X.UseTheDefaultFolder}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{res:Text X.Privacy}" Style="{StaticResource SectionTitle}" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{res:Text X.DetailedDiagnostics}" Style="{DynamicResource Lunar.Text.Body}" />
              <TextBlock x:Name="DiagnosticsHint" Style="{StaticResource Hint}"
                         Text="{res:Text X.WritesMoreDetailToLunar}" />
            </StackPanel>
            <Button x:Name="DiagnosticsSwitch" Grid.Column="1" Style="{DynamicResource Lunar.Style.SwitchButton}" VerticalAlignment="Center"
                    c:SwitchState.IsOn="{Binding DiagnosticsEnabled}" Command="{Binding ToggleDiagnosticsCommand}"
                    automation:AutomationProperties.Name="{res:Text X.DetailedDiagnostics}" />
          </Grid>
          <TextBlock x:Name="DiagnosticsRestart" Text="{res:Text X.TakesEffectTheNextTime}" Style="{StaticResource Hint}"
                     Visibility="{Binding DiagnosticsNeedsRestart, Converter={StaticResource BoolToVisible}}" />
          <TextBlock Text="{res:Text X.SettingsAreSavedOnlyOn}" Style="{StaticResource Hint}" Margin="0,10,0,0" />
        </StackPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{res:Text X.Reset}" Style="{StaticResource SectionTitle}" />
          <StackPanel Visibility="{Binding IsNotConfirmingReset, Converter={StaticResource BoolToVisible}}">
            <Button x:Name="AskResetButton" Content="{res:Text X.ResetAllSettings}" Command="{Binding AskResetCommand}" HorizontalAlignment="Left"
                    Style="{DynamicResource Lunar.Style.ActionButton}" automation:AutomationProperties.Name="{res:Text X.ResetAllSettings2}" />
          </StackPanel>
          <StackPanel x:Name="ResetConfirm" Visibility="{Binding IsConfirmingReset, Converter={StaticResource BoolToVisible}}"
                      automation:AutomationProperties.LiveSetting="Polite">
            <TextBlock Text="{res:Text X.ResetEverySettingToIts}" Style="{DynamicResource Lunar.Text.Body}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
              <Button x:Name="ConfirmResetButton" Content="{res:Text X.Reset}" Command="{Binding ConfirmResetCommand}" Margin="0,0,8,0"
                      Style="{DynamicResource Lunar.Style.ActionButton}" automation:AutomationProperties.Name="{res:Text X.ConfirmResetAllSettings}" />
              <Button x:Name="CancelResetButton" Content="{res:Text X.KeepMySettings}" Command="{Binding CancelResetCommand}"
                      Style="{DynamicResource Lunar.Style.ActionButton}" automation:AutomationProperties.Name="{res:Text X.KeepMySettings}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
