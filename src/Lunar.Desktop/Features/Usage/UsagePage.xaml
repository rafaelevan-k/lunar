<UserControl x:Class="Lunar.Desktop.Features.Usage.UsagePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:c="clr-namespace:Lunar.Desktop.Controls"
             xmlns:local="clr-namespace:Lunar.Desktop.Features.Usage"
             Focusable="False" IsTabStop="False" Background="Transparent"
             automation:AutomationProperties.Name="Usage">
  <!--
    FE-27: the Usage page. It only binds to UsagePageViewModel. The cards use the Claude palette (Usage.* tokens, loaded by the
    code-behind: brand colors normally, Windows colors in High Contrast); the slim row and the switch at the bottom keep the island's own
    black-and-white tokens. The page is built for the island's 250 DIP page height: compact cards, one slim row for status and token
    buttons, and what went wrong said right under the token field. A scroll bar is only the fallback for large text sizes.
  -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisible" />

    <Style x:Key="UsageCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Usage.Brush.Card}" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="BorderBrush" Value="{DynamicResource Usage.Brush.Ink}" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="UsageText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Usage.Brush.Ink}" />
      <Setter Property="FontFamily" Value="{DynamicResource Lunar.Font.Family}" />
      <Setter Property="FontSize" Value="{DynamicResource Lunar.Font.Size.Body}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="UsageMuted" TargetType="TextBlock" BasedOn="{StaticResource UsageText}">
      <Setter Property="Foreground" Value="{DynamicResource Usage.Brush.Muted}" />
      <Setter Property="FontSize" Value="{DynamicResource Lunar.Font.Size.Caption}" />
    </Style>

    <!-- A button on a cream card: the primary one is orange, the quiet one an outline. Theme-independent colors, tokens only. -->
    <Style x:Key="UsageButton" TargetType="Button">
      <Setter Property="c:Squish.Enabled" Value="True" />
      <Setter Property="Focusable" Value="True" />
      <Setter Property="IsTabStop" Value="True" />
      <Setter Property="FocusVisualStyle" Value="{DynamicResource Lunar.Style.FocusVisual}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="12,1" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource Usage.Brush.OnFill}" />
      <Setter Property="FontFamily" Value="{DynamicResource Lunar.Font.Family}" />
      <Setter Property="FontSize" Value="{DynamicResource Lunar.Font.Size.Body}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" CornerRadius="13" Padding="{TemplateBinding Padding}" Background="{DynamicResource Usage.Brush.Fill}"
                    BorderBrush="{DynamicResource Usage.Brush.Ink}" BorderThickness="{DynamicResource Lunar.Thickness.Outline}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="UsageQuietButton" TargetType="Button" BasedOn="{StaticResource UsageButton}">
      <Setter Property="Foreground" Value="{DynamicResource Usage.Brush.Ink}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" CornerRadius="13" Padding="{TemplateBinding Padding}" Background="Transparent"
                    BorderBrush="{DynamicResource Usage.Brush.Ink}" BorderThickness="{DynamicResource Lunar.Thickness.Outline}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The usage bar: a track with a thin ink outline (so its edge is clear on cream) and an orange fill. The percentage is also written. -->
    <Style x:Key="UsageBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="8" />
      <Setter Property="Minimum" Value="0" />
      <Setter Property="Maximum" Value="100" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="4" Background="{DynamicResource Usage.Brush.Track}"
                      BorderBrush="{DynamicResource Usage.Brush.Ink}" BorderThickness="1" />
              <Border x:Name="PART_Indicator" CornerRadius="4" HorizontalAlignment="Left" Background="{DynamicResource Usage.Brush.Fill}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One limit: its name and percentage on one row, the bar, and when it resets. -->
    <DataTemplate DataType="{x:Type local:UsageLimitView}">
      <Border Style="{StaticResource UsageCard}" automation:AutomationProperties.Name="{Binding AutomationName}">
        <StackPanel>
          <DockPanel LastChildFill="False">
            <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" Style="{StaticResource UsageText}" FontWeight="SemiBold" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" Style="{StaticResource UsageText}" FontWeight="SemiBold" />
          </DockPanel>
          <ProgressBar Style="{StaticResource UsageBar}" Value="{Binding Percent, Mode=OneWay}" Margin="0,4,0,0"
                       automation:AutomationProperties.Name="{Binding AutomationName}" />
          <TextBlock Text="{Binding ResetText}" Style="{StaticResource UsageMuted}" Margin="0,3,0,0" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="38,0,38,0">
    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel Margin="0,0,0,2">

        <!-- The brandmark, unmodified, on its own white tile; Refresh sits at the right when there is something to refresh. -->
        <Border x:Name="Header" Style="{StaticResource UsageCard}" Background="{DynamicResource Usage.Brush.Logo}" Padding="10,5">
          <DockPanel LastChildFill="False">
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Margin="6,0,0,0"
                    MinHeight="24" Padding="10,0" VerticalAlignment="Center"
                    Style="{StaticResource UsageQuietButton}" Visibility="{Binding IsActive, Converter={StaticResource BoolToVisible}}"
                    automation:AutomationProperties.Name="Read the limits again" />
            <Image x:Name="Brandmark" DockPanel.Dock="Left" Height="18" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"
                   Source="/Lunar.Desktop;component/Resources/ClaudeBrandmark.jpg" RenderOptions.BitmapScalingMode="HighQuality"
                   automation:AutomationProperties.Name="Claude" />
          </DockPanel>
        </Border>

        <!-- Off: what turning it on does. -->
        <Border x:Name="OffCard" Style="{StaticResource UsageCard}" Visibility="{Binding IsOff, Converter={StaticResource BoolToVisible}}">
          <TextBlock Text="{Binding Disclosure}" Style="{StaticResource UsageText}" FontSize="{DynamicResource Lunar.Font.Size.Caption}" />
        </Border>

        <!-- The sign-in problem, in its own card: Claude Code is not signed in, the sign-in expired, or Claude refused it. The words come from the
             monitor and say what to do; Refresh (in the header) tries again, and the island tries again by itself when it opens. -->
        <Border x:Name="LoginCard" Style="{StaticResource UsageCard}" Visibility="{Binding ShowLoginProblem, Converter={StaticResource BoolToVisible}}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE783;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Usage.Brush.Error}"
                       VerticalAlignment="Top" Margin="0,2,8,0" />
            <TextBlock x:Name="LoginProblemText" Text="{Binding LoginProblemText}" Style="{StaticResource UsageText}" MaxWidth="262"
                       FontSize="{DynamicResource Lunar.Font.Size.Caption}" automation:AutomationProperties.LiveSetting="Assertive" />
          </StackPanel>
        </Border>

        <!-- The limits. -->
        <StackPanel x:Name="Limits" Visibility="{Binding ShowLimits, Converter={StaticResource BoolToVisible}}">
          <ContentControl x:Name="FiveHourLimit" Content="{Binding FiveHour}" Focusable="False" IsTabStop="False" />
          <ContentControl x:Name="WeeklyLimit" Content="{Binding Weekly}" Focusable="False" IsTabStop="False" />
        </StackPanel>

        <!-- One slim line in the island's own colors: when the reading was taken, or what is wrong while the last reading is still shown. -->
        <StackPanel x:Name="StatusCard" Orientation="Horizontal" Margin="2,0,0,2"
                    Visibility="{Binding ShowStatusLine, Converter={StaticResource BoolToVisible}}">
          <TextBlock Text="&#xE783;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Lunar.Brush.Error}"
                     VerticalAlignment="Top" Margin="0,2,6,0"
                     Visibility="{Binding StatusIsProblem, Converter={StaticResource BoolToVisible}}" />
          <TextBlock x:Name="StatusLine" Text="{Binding StatusText}" Style="{DynamicResource Lunar.Text.Caption}" TextWrapping="Wrap" MaxWidth="290"
                     automation:AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- The opt-in switch in the island's own colors, with what the last action did under it. -->
        <Grid Margin="2,2,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Show Claude usage" Style="{DynamicResource Lunar.Text.Body}" VerticalAlignment="Center" />
          <Button x:Name="EnableSwitch" Grid.Column="1" Style="{DynamicResource Lunar.Style.SwitchButton}"
                  c:SwitchState.IsOn="{Binding IsEnabled, Mode=OneWay}" Command="{Binding ToggleEnabledCommand}"
                  automation:AutomationProperties.Name="Show Claude usage" />
        </Grid>
        <TextBlock x:Name="NoticeLine" Text="{Binding Notice}" Style="{DynamicResource Lunar.Text.Caption}" TextWrapping="Wrap" Margin="2,2,0,0"
                   Visibility="{Binding Notice, Converter={x:Static c:NullToVisibilityConverter.Instance}}"
                   automation:AutomationProperties.LiveSetting="Polite" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
