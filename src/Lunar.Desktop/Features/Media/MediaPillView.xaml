<UserControl x:Class="Lunar.Desktop.Features.MediaControls.MediaPillView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:c="clr-namespace:Lunar.Desktop.Controls"
             Focusable="False" IsTabStop="False" Background="Transparent" Cursor="Hand"
             automation:AutomationProperties.Name="{Binding AccessibleName}">
  <!--
    FE-39, ADR-0026: the collapsed island while music or video plays. The track's thumbnail at the left, cut to a rounded square, and the sound bars at the
    right, which follow what Windows plays. Without artwork a music note stands in. A click opens the island on the Media page. It binds to MediaPillViewModel.
  -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisible" />
  </UserControl.Resources>
  <Grid x:Name="Root" Margin="16,0,18,0">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Border x:Name="Thumbnail" Grid.Column="0" Width="28" Height="28" CornerRadius="7" VerticalAlignment="Center"
            Background="{DynamicResource Lunar.Brush.Surface}">
      <Grid x:Name="ThumbnailClip">
        <Grid.Clip>
          <RectangleGeometry Rect="0,0,28,28" RadiusX="7" RadiusY="7" />
        </Grid.Clip>
        <TextBlock x:Name="ThumbnailPlaceholder" Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Lunar.Brush.TextPrimary}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Visible" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasArtwork}" Value="True">
                  <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Image x:Name="ThumbnailImage" Source="{Binding Artwork}" Stretch="UniformToFill"
               Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisible}}" />
      </Grid>
    </Border>
    <c:PlaybackBarsView x:Name="Bars" Grid.Column="2" Width="32" Height="20" VerticalAlignment="Center" Levels="{Binding Bands}" />
  </Grid>
</UserControl>
