<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Lunar.Desktop.Controls"
                    xmlns:shell="clr-namespace:Lunar.Desktop.Shell">
  <!--
    Reusable control styles (FE-12). Every colour, size and font comes from the theme tokens (Colors.*, Typography,
    Spacing, Components), so the controls follow the dark, light and high-contrast palettes. Load after Components.xaml.
    Every interactive control is a tab stop with the shared focus ring (Lunar.Style.FocusVisual) and a disabled look
    that is not colour alone (reduced opacity plus the disabled text colour).
    Keys: Lunar.Style.Slider, Lunar.Style.Toggle, Lunar.Style.SwitchButton, Lunar.Style.ActionButton, and implicit styles for IconButton,
    StatusChip, InlineError, SkeletonBlock and ToolTip.
  -->
  <shell:StadiumRadiusConverter x:Key="Lunar.Converter.Stadium" />

  <!-- ===== Slider ===== -->
  <Style x:Key="Lunar.Style.SliderTrack" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <!-- A taller transparent strip keeps the click target generous while the visible bar stays 4 DIP high. -->
          <Border Background="Transparent" Height="24">
            <Border x:Name="Bar" Height="4" CornerRadius="2" Background="{DynamicResource Lunar.Brush.TextDisabled}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Lunar.Style.SliderFill" TargetType="RepeatButton" BasedOn="{StaticResource Lunar.Style.SliderTrack}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" Height="24">
            <Border Height="4" CornerRadius="2" Background="{DynamicResource Lunar.Brush.Accent}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Lunar.Style.SliderThumb" TargetType="Thumb">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Grid>
            <!-- The focus ring is drawn around the thumb while the slider has keyboard focus. -->
            <Ellipse x:Name="FocusRing" Margin="-3" StrokeThickness="2" Stroke="{DynamicResource Lunar.Brush.Focus}" Visibility="Collapsed" />
            <Ellipse x:Name="Knob" Fill="{DynamicResource Lunar.Brush.Accent}" Stroke="{DynamicResource Lunar.Brush.OnAccent}" StrokeThickness="2" />
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource AncestorType=Slider}}" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Lunar.Brush.TextPrimary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Lunar.Style.Slider" TargetType="Slider">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="IsMoveToPointEnabled" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid x:Name="Root" Background="Transparent" SnapsToDevicePixels="True">
            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource Lunar.Style.SliderFill}" Command="Slider.DecreaseLarge" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource Lunar.Style.SliderTrack}" Command="Slider.IncreaseLarge" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource Lunar.Style.SliderThumb}" />
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Toggle switch ===== -->
  <Style x:Key="Lunar.Style.Toggle" TargetType="ToggleButton">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="Foreground" Value="{DynamicResource Lunar.Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Lunar.Font.Family}" />
    <Setter Property="FontSize" Value="{DynamicResource Lunar.Font.Size.Body}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <StackPanel x:Name="Root" Orientation="Horizontal" Background="Transparent">
            <Grid Width="40" Height="22" VerticalAlignment="Center">
              <Rectangle x:Name="FocusRing" Margin="-3" RadiusX="14" RadiusY="14" StrokeThickness="2"
                         Stroke="{DynamicResource Lunar.Brush.Focus}" Visibility="Collapsed" />
              <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource Lunar.Brush.Surface}"
                      BorderBrush="{DynamicResource Lunar.Brush.TextDisabled}" BorderThickness="1" />
              <Ellipse x:Name="Knob" Width="14" Height="14" Margin="4,0" HorizontalAlignment="Left"
                       Fill="{DynamicResource Lunar.Brush.TextSecondary}" />
            </Grid>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Lunar.Brush.Accent}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Lunar.Brush.Accent}" />
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Lunar.Brush.OnAccent}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Lunar.Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.4" />
              <Setter Property="Foreground" Value="{DynamicResource Lunar.Brush.TextDisabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!--
    ===== Switch button (FE-15) =====
    A switch that is a plain Button, so pressing it only asks (it never flips itself): it draws the on or off state of the
    attached c:SwitchState.IsOn (bind it to the confirmed state) and changes only when that state changes. Because it is a Button it
    supports the Invoke pattern, so assistive technology can press it; give it an accessible name that says the action.
  -->
  <Style x:Key="Lunar.Style.SwitchButton" TargetType="Button">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <Rectangle x:Name="FocusRing" Margin="-3" RadiusX="14" RadiusY="14" StrokeThickness="2"
                       Stroke="{DynamicResource Lunar.Brush.Focus}" Visibility="Collapsed" />
            <Border x:Name="Track" CornerRadius="11" Background="{DynamicResource Lunar.Brush.Surface}"
                    BorderBrush="{DynamicResource Lunar.Brush.TextDisabled}" BorderThickness="1" />
            <Ellipse x:Name="Knob" Width="14" Height="14" Margin="4,0" HorizontalAlignment="Left"
                     Fill="{DynamicResource Lunar.Brush.TextSecondary}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="c:SwitchState.IsOn" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{DynamicResource Lunar.Brush.Accent}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Lunar.Brush.Accent}" />
              <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Lunar.Brush.OnAccent}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Lunar.Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Text action button (for example Retry) ===== -->
  <Style x:Key="Lunar.Style.ActionButton" TargetType="Button">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Lunar.Style.FocusVisual}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="Foreground" Value="{DynamicResource Lunar.Brush.Accent}" />
    <Setter Property="FontFamily" Value="{DynamicResource Lunar.Font.Family}" />
    <Setter Property="FontSize" Value="{DynamicResource Lunar.Font.Size.Body}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Face" CornerRadius="14" Padding="{TemplateBinding Padding}" Background="{DynamicResource Lunar.Brush.Surface}"
                  BorderBrush="{DynamicResource Lunar.Brush.Accent}" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Lunar.Brush.Accent}" />
              <Setter Property="Foreground" Value="{DynamicResource Lunar.Brush.OnAccent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Face" Property="Opacity" Value="0.4" />
              <Setter Property="Foreground" Value="{DynamicResource Lunar.Brush.TextDisabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Icon button ===== -->
  <Style TargetType="c:IconButton">
    <Setter Property="Focusable" Value="True" />
    <Setter Property="IsTabStop" Value="True" />
    <Setter Property="FocusVisualStyle" Value="{DynamicResource Lunar.Style.FocusVisual}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Width" Value="32" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Foreground" Value="{DynamicResource Lunar.Brush.TextPrimary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:IconButton">
          <Border x:Name="Face" Background="{DynamicResource Lunar.Brush.Surface}" BorderBrush="{DynamicResource Lunar.Brush.TextDisabled}"
                  BorderThickness="1"
                  CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Lunar.Converter.Stadium}}">
            <TextBlock x:Name="Icon" Text="{TemplateBinding Glyph}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{TemplateBinding Foreground}" FontSize="14"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets, Segoe UI Symbol, Segoe UI" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Lunar.Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Face" Property="Background" Value="{DynamicResource Lunar.Brush.Accent}" />
              <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Lunar.Brush.OnAccent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Face" Property="Opacity" Value="0.4" />
              <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Lunar.Brush.TextDisabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Status chip ===== -->
  <Style TargetType="c:StatusChip">
    <Setter Property="Foreground" Value="{DynamicResource Lunar.Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Lunar.Font.Family}" />
    <Setter Property="FontSize" Value="{DynamicResource Lunar.Font.Size.Caption}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:StatusChip">
          <Border x:Name="Frame" Background="{DynamicResource Lunar.Brush.Surface}" BorderBrush="{DynamicResource Lunar.Brush.TextDisabled}"
                  BorderThickness="1" Padding="8,2" MinHeight="22"
                  CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource Lunar.Converter.Stadium}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock x:Name="Symbol" Text="{TemplateBinding Glyph}" FontWeight="Bold" Margin="0,0,6,0"
                         Foreground="{DynamicResource Lunar.Brush.TextSecondary}" />
              <TextBlock Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Kind" Value="Info">
              <Setter TargetName="Symbol" Property="Foreground" Value="{DynamicResource Lunar.Brush.Accent}" />
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Lunar.Brush.Accent}" />
            </Trigger>
            <Trigger Property="Kind" Value="Success">
              <Setter TargetName="Symbol" Property="Foreground" Value="{DynamicResource Lunar.Brush.Success}" />
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Lunar.Brush.Success}" />
            </Trigger>
            <Trigger Property="Kind" Value="Error">
              <Setter TargetName="Symbol" Property="Foreground" Value="{DynamicResource Lunar.Brush.Error}" />
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Lunar.Brush.Error}" />
            </Trigger>
            <Trigger Property="Kind" Value="Unavailable">
              <Setter TargetName="Symbol" Property="Foreground" Value="{DynamicResource Lunar.Brush.TextDisabled}" />
              <Setter Property="Foreground" Value="{DynamicResource Lunar.Brush.TextSecondary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Skeleton ===== -->
  <Style TargetType="c:SkeletonBlock">
    <Setter Property="Background" Value="{DynamicResource Lunar.Brush.Surface}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:SkeletonBlock">
          <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                  BorderBrush="{DynamicResource Lunar.Brush.Border}" BorderThickness="1" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Inline error ===== -->
  <Style TargetType="c:InlineError">
    <Setter Property="Foreground" Value="{DynamicResource Lunar.Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Lunar.Font.Family}" />
    <Setter Property="FontSize" Value="{DynamicResource Lunar.Font.Size.Body}" />
    <Setter Property="Margin" Value="8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="c:InlineError">
          <Border Background="{DynamicResource Lunar.Brush.Surface}" BorderBrush="{DynamicResource Lunar.Brush.Error}" BorderThickness="1"
                  CornerRadius="8" Padding="8">
            <DockPanel LastChildFill="True">
              <!-- A symbol as well as colour, so the error is recognisable without seeing red. -->
              <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0" VerticalAlignment="Top"
                      Background="{DynamicResource Lunar.Brush.Error}">
                <TextBlock Text="!" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource Lunar.Brush.OnAccent}" />
              </Border>
              <c:IconButton x:Name="PART_Dismiss" DockPanel.Dock="Right" Width="28" Height="28" Margin="8,0,0,0" VerticalAlignment="Top"
                            Glyph="&#xE711;" Label="Dismiss error" Command="{TemplateBinding DismissCommand}"
                            Visibility="{Binding DismissCommand, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static c:NullToVisibilityConverter.Instance}}" />
              <Button x:Name="PART_Action" DockPanel.Dock="Right" Style="{StaticResource Lunar.Style.ActionButton}" Margin="8,0,0,0"
                      VerticalAlignment="Top" Content="{TemplateBinding ActionText}" Command="{TemplateBinding ActionCommand}"
                      Visibility="{Binding ActionCommand, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static c:NullToVisibilityConverter.Instance}}" />
              <TextBlock Text="{TemplateBinding Message}" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Tooltip (implicit: every tooltip in the app) ===== -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource Lunar.Brush.TextPrimary}" />
    <Setter Property="FontFamily" Value="{DynamicResource Lunar.Font.Family}" />
    <Setter Property="FontSize" Value="{DynamicResource Lunar.Font.Size.Caption}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource Lunar.Brush.Surface}" BorderBrush="{DynamicResource Lunar.Brush.TextDisabled}" BorderThickness="1"
                  CornerRadius="6" Padding="8,4" MaxWidth="280">
            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
