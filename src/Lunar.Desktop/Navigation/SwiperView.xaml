<UserControl x:Class="Lunar.Desktop.Navigation.SwiperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:behaviors="clr-namespace:Lunar.Desktop.Behaviors"
             xmlns:c="clr-namespace:Lunar.Desktop.Controls"
             Focusable="True" Background="Transparent"
             FocusVisualStyle="{DynamicResource Lunar.Style.FocusVisual}"
             automation:AutomationProperties.Name="Pages">
  <UserControl.Resources>
    <!-- Round arrow button: not a tab stop and never takes focus, so using it cannot pull focus out of a slider. -->
    <Style x:Key="SwiperArrow" TargetType="Button">
      <Setter Property="c:Squish.Enabled" Value="True" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Lunar.Brush.TextPrimary}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" CornerRadius="14" Background="{DynamicResource Lunar.Brush.Surface}"
                    BorderBrush="{DynamicResource Lunar.Brush.Border}" BorderThickness="{DynamicResource Lunar.Thickness.Outline}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Lunar.Brush.Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A page dot that is also an accessible tab: a radio button in one group, so the arrow keys move between pages. -->
    <Style x:Key="SwiperDot" TargetType="RadioButton">
      <Setter Property="GroupName" Value="Lunar.Pages" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{DynamicResource Lunar.Style.FocusVisual}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border Background="Transparent" Padding="3">
              <!-- Every dot is the same small circle; the current page's dot is white (the accent), the others are gray. -->
              <Border x:Name="Dot" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Lunar.Brush.TextDisabled}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Lunar.Brush.TextSecondary}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Lunar.Brush.Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- The pages sit side by side on a canvas, which adds nothing to the control's desired size, so wide pages can never
         make the island ask for a wider window. -->
    <Grid x:Name="Viewport" Grid.Row="0" ClipToBounds="True" Background="Transparent" MinHeight="0">
      <Canvas>
        <StackPanel x:Name="Strip" Orientation="Horizontal">
          <StackPanel.RenderTransform>
            <TranslateTransform x:Name="StripOffset" />
          </StackPanel.RenderTransform>
        </StackPanel>
      </Canvas>
      <Button x:Name="PreviousButton" Style="{StaticResource SwiperArrow}" HorizontalAlignment="Left" Content="‹"
              automation:AutomationProperties.Name="Previous page" Click="OnPreviousClick" />
      <Button x:Name="NextButton" Style="{StaticResource SwiperArrow}" HorizontalAlignment="Right" Content="›"
              automation:AutomationProperties.Name="Next page" Click="OnNextClick" />
    </Grid>

    <StackPanel x:Name="Dots" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,8" />
  </Grid>
</UserControl>
