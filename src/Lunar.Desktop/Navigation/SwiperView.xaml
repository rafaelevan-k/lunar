<UserControl x:Class="Lunar.Desktop.Navigation.SwiperView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Lunar.Desktop.Resources"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:behaviors="clr-namespace:Lunar.Desktop.Behaviors"
             xmlns:c="clr-namespace:Lunar.Desktop.Controls"
             Focusable="True" Background="Transparent"
             FocusVisualStyle="{DynamicResource Lunar.Style.FocusVisual}"
             automation:AutomationProperties.Name="{res:Text X.Pages}">
  <UserControl.Resources>
    <!-- Round arrow button: not a tab stop and never takes focus, so using it cannot pull focus out of a slider. -->
    <Style x:Key="SwiperArrow" TargetType="Button">
      <Setter Property="c:Squish.Enabled" Value="True" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Width" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Lunar.Brush.TextPrimary}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Face" CornerRadius="14" Background="{DynamicResource Lunar.Brush.Surface}"
                    BorderBrush="{DynamicResource Lunar.Brush.Border}" BorderThickness="{DynamicResource Lunar.Thickness.Outline}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource Lunar.Brush.Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Face" Property="Opacity" Value="0.35" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SwiperChevron" TargetType="Path">
      <Setter Property="Width" Value="7" />
      <Setter Property="Height" Value="13" />
      <Setter Property="Stretch" Value="None" />
      <Setter Property="StrokeThickness" Value="2.4" />
      <Setter Property="StrokeStartLineCap" Value="Round" />
      <Setter Property="StrokeEndLineCap" Value="Round" />
      <Setter Property="StrokeLineJoin" Value="Round" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
    </Style>

    <!-- A page dot that is also an accessible tab: a radio button in one group, so the arrow keys move between pages. -->
    <Style x:Key="SwiperDot" TargetType="RadioButton">
      <Setter Property="GroupName" Value="Lunar.Pages" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{DynamicResource Lunar.Style.FocusVisual}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border Background="Transparent" Padding="3">
              <!-- Every dot is the same small circle; the current page's dot is white (the accent), the others are gray. -->
              <Border x:Name="Dot" Width="8" Height="8" CornerRadius="4" Background="{DynamicResource Lunar.Brush.TextDisabled}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Lunar.Brush.TextSecondary}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Dot" Property="Background" Value="{DynamicResource Lunar.Brush.Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!--
      ADR-0027 (amended 2026-11-18): in the Notch style the pages are tabs along the top of the open panel, as on the notch-style islands of current
      MacBooks, instead of the side arrows and the dots. A tab is a radio button in its own group: a symbol, and the page's name when it is the current one.
    -->
    <Style x:Key="NotchTab" TargetType="RadioButton">
      <Setter Property="GroupName" Value="Lunar.PageTabs" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="{DynamicResource Lunar.Brush.TextSecondary}" />
      <Setter Property="FocusVisualStyle" Value="{DynamicResource Lunar.Style.FocusVisual}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Face" CornerRadius="13" Height="26" Padding="10,0" Background="Transparent">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="Glyph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="13" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{TemplateBinding Foreground}" Visibility="Collapsed" />
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Lunar.Brush.TextPrimary}" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Face" Property="Background" Value="{DynamicResource Lunar.Brush.Surface}" />
                <Setter TargetName="Label" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="{DynamicResource Lunar.Brush.TextPrimary}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel x:Name="Tabs" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,8" Visibility="Collapsed"
                automation:AutomationProperties.Name="{res:Text X.Pages}" />

    <!-- The pages sit side by side on a canvas, which adds nothing to the control's desired size, so wide pages can never
         make the island ask for a wider window. -->
    <Grid x:Name="Viewport" Grid.Row="1" ClipToBounds="True" Background="Transparent" MinHeight="0">
      <Canvas>
        <StackPanel x:Name="Strip" Orientation="Horizontal">
          <StackPanel.RenderTransform>
            <TranslateTransform x:Name="StripOffset" />
          </StackPanel.RenderTransform>
        </StackPanel>
      </Canvas>
      <Button x:Name="PreviousButton" Style="{StaticResource SwiperArrow}" HorizontalAlignment="Left"
              automation:AutomationProperties.Name="{res:Text X.PreviousPage}" Click="OnPreviousClick">
        <!-- A drawn chevron (not a text glyph, whose side bearings push it off centre): its box is centred in the circle. -->
        <Path x:Name="PreviousChevron" Style="{StaticResource SwiperChevron}" Data="M 6,1 L 1,6.5 L 6,12" />
      </Button>
      <Button x:Name="NextButton" Style="{StaticResource SwiperArrow}" HorizontalAlignment="Right"
              automation:AutomationProperties.Name="{res:Text X.NextPage}" Click="OnNextClick">
        <Path x:Name="NextChevron" Style="{StaticResource SwiperChevron}" Data="M 1,1 L 6,6.5 L 1,12" />
      </Button>
    </Grid>

    <StackPanel x:Name="Dots" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,8" />
  </Grid>
</UserControl>
