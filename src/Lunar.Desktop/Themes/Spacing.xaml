<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Spacing scale from PRD §3.5, in device-independent pixels. -->
  <sys:Double x:Key="Lunar.Space.XS">4</sys:Double>
  <sys:Double x:Key="Lunar.Space.S">8</sys:Double>
  <sys:Double x:Key="Lunar.Space.M">12</sys:Double>
  <sys:Double x:Key="Lunar.Space.L">16</sys:Double>
  <sys:Double x:Key="Lunar.Space.XL">24</sys:Double>

  <Thickness x:Key="Lunar.Padding.XS">4</Thickness>
  <Thickness x:Key="Lunar.Padding.S">8</Thickness>
  <Thickness x:Key="Lunar.Padding.M">12</Thickness>
  <Thickness x:Key="Lunar.Padding.L">16</Thickness>
  <Thickness x:Key="Lunar.Padding.XL">24</Thickness>

  <!-- Corner radii from PRD §3.5. -->
  <CornerRadius x:Key="Lunar.Radius.Pill">999</CornerRadius>
  <CornerRadius x:Key="Lunar.Radius.Panel">24</CornerRadius>
</ResourceDictionary>
