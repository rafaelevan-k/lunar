<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The light form of Colors.Settings.Dark.xaml: soft paper grey and graphite instead of white and black, thin outlines, body text at least 4.5:1. -->
  <Color x:Key="Lunar.Color.Background">#ECEDF0</Color>
  <Color x:Key="Lunar.Color.Surface">#F6F6F8</Color>
  <Color x:Key="Lunar.Color.TextPrimary">#34363C</Color>
  <Color x:Key="Lunar.Color.TextSecondary">#62666F</Color>
  <Color x:Key="Lunar.Color.TextDisabled">#9A9EA6</Color>
  <Color x:Key="Lunar.Color.Accent">#4A4D55</Color>
  <Color x:Key="Lunar.Color.OnAccent">#F6F6F8</Color>
  <Color x:Key="Lunar.Color.Focus">#4A4D55</Color>
  <Color x:Key="Lunar.Color.Border">#D6D8DD</Color>
  <SolidColorBrush x:Key="Lunar.Brush.Background" Color="#ECEDF0" />
  <SolidColorBrush x:Key="Lunar.Brush.Surface" Color="#F6F6F8" />
  <SolidColorBrush x:Key="Lunar.Brush.TextPrimary" Color="#34363C" />
  <SolidColorBrush x:Key="Lunar.Brush.TextSecondary" Color="#62666F" />
  <SolidColorBrush x:Key="Lunar.Brush.TextDisabled" Color="#9A9EA6" />
  <SolidColorBrush x:Key="Lunar.Brush.Accent" Color="#4A4D55" />
  <SolidColorBrush x:Key="Lunar.Brush.OnAccent" Color="#F6F6F8" />
  <SolidColorBrush x:Key="Lunar.Brush.Focus" Color="#4A4D55" />
  <SolidColorBrush x:Key="Lunar.Brush.Border" Color="#D6D8DD" />
  <Thickness x:Key="Lunar.Thickness.Outline">1</Thickness>
</ResourceDictionary>
