<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    FE-27: the Claude palette, for the Usage page and its pop-up only (ADR-0014); the rest of the island stays black and white.
    Brand values: cream #FAF9F5, dark #141413, orange #D97757, light gray #E8E6DC. The brand mid gray (#B0AEA5) is too pale for text on
    cream, so secondary text uses #5E5D59 and errors #A12A1E; both are checked by UsagePaletteTests. Every Usage.* key exists in
    Colors.Usage.HighContrast.xaml too.
  -->
  <Color x:Key="Usage.Color.Card">#FAF9F5</Color>
  <Color x:Key="Usage.Color.Logo">#FFFFFF</Color>
  <Color x:Key="Usage.Color.Ink">#141413</Color>
  <Color x:Key="Usage.Color.Muted">#5E5D59</Color>
  <Color x:Key="Usage.Color.Track">#E8E6DC</Color>
  <Color x:Key="Usage.Color.Fill">#D97757</Color>
  <Color x:Key="Usage.Color.OnFill">#141413</Color>
  <Color x:Key="Usage.Color.Error">#A12A1E</Color>

  <SolidColorBrush x:Key="Usage.Brush.Card" Color="{StaticResource Usage.Color.Card}" />
  <SolidColorBrush x:Key="Usage.Brush.Logo" Color="{StaticResource Usage.Color.Logo}" />
  <SolidColorBrush x:Key="Usage.Brush.Ink" Color="{StaticResource Usage.Color.Ink}" />
  <SolidColorBrush x:Key="Usage.Brush.Muted" Color="{StaticResource Usage.Color.Muted}" />
  <SolidColorBrush x:Key="Usage.Brush.Track" Color="{StaticResource Usage.Color.Track}" />
  <SolidColorBrush x:Key="Usage.Brush.Fill" Color="{StaticResource Usage.Color.Fill}" />
  <SolidColorBrush x:Key="Usage.Brush.OnFill" Color="{StaticResource Usage.Color.OnFill}" />
  <SolidColorBrush x:Key="Usage.Brush.Error" Color="{StaticResource Usage.Color.Error}" />
</ResourceDictionary>
