<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The Settings window's own soft palette (2026-11-18, the owner: "warna hitam dan putih yang soft dan tidak kontras"). Charcoal and warm grey instead
    of near-black and pure white, thin outlines. Body text keeps at least 4.5:1 on every surface (ThemeTokenTests). It replaces the Lunar palette only
    inside the Settings window; High Contrast keeps Windows' colours.
  -->
  <Color x:Key="Lunar.Color.Background">#1B1C20</Color>
  <Color x:Key="Lunar.Color.Surface">#25272C</Color>
  <Color x:Key="Lunar.Color.TextPrimary">#DADCE1</Color>
  <Color x:Key="Lunar.Color.TextSecondary">#A0A4AE</Color>
  <Color x:Key="Lunar.Color.TextDisabled">#6C707A</Color>
  <Color x:Key="Lunar.Color.Accent">#C9CCD3</Color>
  <Color x:Key="Lunar.Color.OnAccent">#1B1C20</Color>
  <Color x:Key="Lunar.Color.Focus">#B9BDC6</Color>
  <Color x:Key="Lunar.Color.Border">#3A3D44</Color>
  <SolidColorBrush x:Key="Lunar.Brush.Background" Color="#1B1C20" />
  <SolidColorBrush x:Key="Lunar.Brush.Surface" Color="#25272C" />
  <SolidColorBrush x:Key="Lunar.Brush.TextPrimary" Color="#DADCE1" />
  <SolidColorBrush x:Key="Lunar.Brush.TextSecondary" Color="#A0A4AE" />
  <SolidColorBrush x:Key="Lunar.Brush.TextDisabled" Color="#6C707A" />
  <SolidColorBrush x:Key="Lunar.Brush.Accent" Color="#C9CCD3" />
  <SolidColorBrush x:Key="Lunar.Brush.OnAccent" Color="#1B1C20" />
  <SolidColorBrush x:Key="Lunar.Brush.Focus" Color="#B9BDC6" />
  <SolidColorBrush x:Key="Lunar.Brush.Border" Color="#3A3D44" />
  <Thickness x:Key="Lunar.Thickness.Outline">1</Thickness>
</ResourceDictionary>
